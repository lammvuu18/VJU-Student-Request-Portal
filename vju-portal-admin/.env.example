# Copy thành .env.local khi chạy local. Biến REACT_APP_* được nhúng lúc build,
# đổi giá trị trên Render thì phải build lại (Manual Deploy).

# URL backend, gồm cả /api
REACT_APP_API_BASE_URL=http://localhost:8000/api

# Google OAuth Client ID (Web application), phải trùng GOOGLE_CLIENT_ID của backend.
# Để trống khi dev: nút Google mở trang chọn tài khoản giả, cần backend bật GOOGLE_AUTH_DEV_BYPASS=True
REACT_APP_GOOGLE_CLIENT_ID=

# true: dùng dữ liệu mock khi backend không chạy (chỉ để xem giao diện)
REACT_APP_USE_MOCK=false
